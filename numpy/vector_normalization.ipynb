   "source": [
    "# standard vector normalization\n",
    "arr = np.array([10,20,30,40])\n",
    "\n",
    "mean = np.mean(arr)\n",
    "std = np.std(arr)\n",
    "\n",
    "normalized_arr = (arr - mean) / std\n",
    "print(normalized_arr)\n",
    "\n",
    "\n"
   ]
